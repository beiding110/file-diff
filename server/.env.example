# BidComparator 服务配置示例
# 复制为系统环境变量或在启动前 set/export，服务直接读 process.env，不依赖 dotenv

# 监听端口
PORT=3000

# 监听地址（0.0.0.0 允许局域网访问）
HOST=0.0.0.0

# 最大并发执行任务数。对比是 CPU 密集型，默认 1（排队执行）。
# 注意：>1 时多个任务共享全局对比设置，可能互相覆盖
CONCURRENCY=1

# diff 线程数：留空按 CPU 核数；也可指定数字（如 4）
WORKERS=

# 缓存目录（解析结果 / 对比结果 / PDF 与图片副本）
CACHE_PATH=E:\Git\file-diff\cache

# 上传文件的临时目录（默认系统临时目录）
TMP_DIR=

# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=200

# 单次任务投标文件数量上限
MAX_FILES=50

# 内存中保留的终态任务元数据条数上限
MAX_FINISHED_TASKS=200

# 被服务化的库入口：默认源码 index.js，可指向 dist 产物
# LIB_ENTRY=E:\Git\file-diff\dist\BidComparator.js
